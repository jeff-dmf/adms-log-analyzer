    "js_kb_open": {"label": "JavaScript on open", "unit": "KB", "max": 450, "baseline": 912},
    "js_modules_open": {"label": "JavaScript modules on open", "unit": "count", "max": 40, "baseline": 72},
    "css_files_open": {"label": "CSS files on open", "unit": "count", "max": 12, "baseline": 19},
