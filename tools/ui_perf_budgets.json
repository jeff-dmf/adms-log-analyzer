    "inp_search_ms": {"label": "INP, search", "unit": "ms", "max": 100, "warn": 50, "baseline": 24},
    "filter_to_rows_ms": {"label": "Filter to new rows", "unit": "ms", "max": 200, "baseline": 24},
    "search_to_rows_ms": {"label": "Search to new rows", "unit": "ms", "max": 200, "baseline": 40},
    "scroll_forced_layouts": {"label": "Forced layouts in 120 wheel events", "unit": "count", "max": 0, "baseline": 120},
    "scroll_work_per_frame_ms": {"label": "Main-thread work per frame while scrolling", "unit": "ms", "max": 4},
