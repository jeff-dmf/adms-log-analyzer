{
  "family": "AAVL",
  "scenarios": [
    {
      "name": "ok_pair_with_duration",
      "lines": [
        [1000, 5, "\"ChangedVehiclesCoordinatesEvent\": 11111111-1111-4111-8111-111111111111 message processing started..."],
        [1005, 5, "Position is updated for vehicle(s). For more details check sensitive log."],
        [1016, 5, "\"ChangedVehiclesCoordinatesEvent\": 11111111-1111-4111-8111-111111111111 message processing finished successfully."]
      ],
      "expect": [
        {"name": "ChangedVehiclesCoordinatesEvent", "status": "ok", "duration_ms": 16, "n_entries": 3, "key": "11111111-1111-4111-8111-111111111111"}
      ]
    },
    {
      "name": "vehicle_not_found_is_business_error",
      "lines": [
        [2000, 5, "\"ChangedVehiclesCoordinatesEvent\": 11111111-1111-4111-8111-111111111111 message processing started..."],
        [2001, 5, "[Validation Critical]: VehicleNotFound"],
        [2002, 5, "[SystemEventSender] System event message: [AdapterAVL] Received message is invalid"],
        [2031, 5, "\"ChangedVehiclesCoordinatesEvent\": 11111111-1111-4111-8111-111111111111 message processing finished successfully."]
      ],
      "expect": [
        {"name": "ChangedVehiclesCoordinatesEvent", "status": "business_error", "duration_ms": 31, "n_entries": 4}
      ]
    },
    {
      "name": "validation_only_stays_ok",
      "lines": [
        [3000, 5, "\"ChangedVehiclesCoordinatesEvent\": 11111111-1111-4111-8111-111111111111 message processing started..."],
        [3001, 5, "[Validation Critical]: VehicleNotFound"],
        [3015, 5, "\"ChangedVehiclesCoordinatesEvent\": 11111111-1111-4111-8111-111111111111 message processing finished successfully."]
      ],
      "expect": [
        {"name": "ChangedVehiclesCoordinatesEvent", "status": "ok", "duration_ms": 15, "n_entries": 3}
      ]
    },
    {
      "name": "no_end_at_eof_is_open",
      "lines": [
        [4000, 5, "\"ChangedVehiclesCoordinatesEvent\": 11111111-1111-4111-8111-111111111111 message processing started..."]
      ],
      "expect": [
        {"name": "ChangedVehiclesCoordinatesEvent", "status": "open", "duration_ms": null}
      ]
    },
    {
      "name": "end_with_another_guid_is_ignored",
      "lines": [
        [5000, 5, "\"ChangedVehiclesCoordinatesEvent\": 11111111-1111-4111-8111-111111111111 message processing started..."],
        [5010, 5, "\"ChangedVehiclesCoordinatesEvent\": 22222222-2222-4222-8222-222222222222 message processing finished successfully."]
      ],
      "expect": [
        {"name": "ChangedVehiclesCoordinatesEvent", "status": "open", "duration_ms": null}
      ]
    }
  ]
}
